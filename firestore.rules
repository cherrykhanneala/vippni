rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.vendorId;
    }

    // Orders collection
    match /orders/{orderId} {
      // Allow customers to read and write their own orders
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Vendor orders subcollection
    match /vendors/{vendorId}/orders/{orderId} {
      // Allow vendors to read and write their own orders
      allow read, write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vendors collection
    match /vendors/{vendorId} {
      allow read, write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
